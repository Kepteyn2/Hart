"ydq" = (/mob/living/simple_animal/hostile/retaliate/frog,/turf/open/floor/rogue/grass,/area/rogue/outdoors)
"ydt" = (/obj/item/natural/rock,/obj/effect/decal/cleanable/debris/stony,/obj/effect/decal/cleanable/blood/old,/obj/item/clothing/cloak/templar/malummite,/obj/item/clothing/neck/roguetown/psicross/malum,/obj/item/paper{name = "Forgotten Note"; info = "I have been digging for weeks. It is very dark. My torches have all gone out. I feel like a drow. I've been on this adventure to locate the lost people beneath this castle, sent here by the priest. I can't find it ... maybe I went the wrong way? Malum must know I am close. I'll keep digging. I keep hearing a rous behind me too, but I have been hearing that for daes. I'm just a dwarf, so I hope it doesn't get me, it's probably bigger than I am. I shouldn't worry about it. I will just keep digging, although this water has me concerned. If the tunnel collapses, it may trap me. If you are reading this and I am dead, the tunnel or rat got me. Take this to the priest and tell them Ulman Doomforged sent ya and have a drink in my name!"; desc = "A note written some time before death. The handwriting is clear, and it doesn't appear panicked. Notably, the note is blood-stained with a big, fat bloody finger print on the edge of the parchment. It is too big to be a dwarf's, and it's definitely not my finger print. Who could have done this?.. Cruelty knows no bounds."},/obj/effect/decal/cleanable/blood/gibs/old,/turf/open/floor/rogue/naturalstone,/area/rogue/under/cavewet/bogcaves)
