"nzT" = (/obj/item/paper/contract{name = "Assassination Contract"; desc = "You are assigned to KILL an enigmatic individual located in the Heartfelt territory, contracted by the Queen of the Kingdom of Ferentia and the Emperor of Zybantium, supported by the Church of the Ten and High Priestess Seraphina. They are located to the north-east, in a tall, black-and-red tower protected by deadites, infernal summons, and an infernal watcher. They will be in the top of their tower, alone. BEWARE: THIS INDIVIDUAL IS UNIMAGINABLY DANGEROUS. DO NOT APPROACH ALONE. It is advisable to destroy the tower via the provided explosive satchel, and then kill the entity after its collapse. The reward for completion is one-thousand zenarii."},/turf/open/floor/rogue/churchmarble,/area/rogue/underworld{name = "screamingforestheartfelt"; ambientnight = list('sound/ambience/bognight.ogg'); ambientrain = list('sound/ambience/rainout.ogg'); ambientsounds = list('sound/ambience/bogday (1).ogg','sound/ambience/bogday(2).ogg','sound/ambience/bogday(3).ogg','sound/ambience/forestday.ogg'); ambush_mobs = list(/mob/living/simple_animal/hostile/rogue/haunt = 95, /mob/living/carbon/human/species/skeleton/npc/ambush = 20); ambush_times = list("night","dawn","dusk","day"); ambush_types = list(/turf/open/floor/rogue/dirt,/turf/open/floor/rogue/grass,/turf/open/water); first_time_text = "THE SCREAMING FOREST"; spookynight = list('sound/ambience/noises/genspooky (1).ogg','sound/ambience/noises/genspooky(4).ogg','sound/ambience/noises/genspooky(2).ogg','sound/ambience/noises/genspooky(3).ogg','sound/ambience/noises/genspooky(5).ogg','sound/ambience/noises/werewolf_howl_04.ogg','sound/ambience/noises/wolf(2).ogg','sound/ambience/noises/wolf(3).ogg'); spookysounds = list('sound/ambience/noises/birds (1).ogg','sound/ambience/noises/birds(2).ogg','sound/ambience/noises/birds(3).ogg','sound/ambience/noises/birds(4).ogg','sound/ambience/noises/birds(5).ogg','sound/ambience/noises/birds(6).ogg','sound/ambience/noi