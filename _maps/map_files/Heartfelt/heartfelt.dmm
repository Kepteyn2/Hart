"xaJ" = (/obj/structure/fluff/statue/psy{icon_state = "Hoardmaster"; pixel_y = -10; pixel_x = -10; name = "STATUE OF KYRAXINOTH"; desc = "A beautiful black-and-gold dragon statue dedicated to the non-deific dragon known as Kyraxinoth. His name is meticulously etched in gold leaf at the base of the statue, and he appears to be laying just a touch above the waters. This place feels sacred, and it seems to be protected by some sort of power. Still, when I gaze upon this statue's saffrie eyes I feel an overwhelming, titanic entity looking back at me. It almost makes me feel anxious. Whoever built this must revere them very much, and I can't help but think that whatever Kyraxinoth is may be watching me."},/turf/open/floor/rogue/blocks,/area/rogue/under/lake{outdoors = 1; name = "lakeheartfelt"; droning_sound = 'sound/newmusic/General_Ambient2.ogg'; droning_sound_night = 'sound/newmusic/DUNGEONLOWER.ogg'; spookysounds = list('sound/ambience/noises/birds (1).ogg','sound/ambience/noises/birds(2).ogg','sound/ambience/noises/birds(3).ogg','sound/ambience/noises/birds(4).ogg','sound/ambience/noises/birds(5).ogg','sound/ambience/noises/birds(6).ogg','sound/ambience/noises/birds(7).ogg'); spookynight = list('sound/ambience/noises/werewolf_howl_04.ogg','sound/ambience/noises/wolf(2).ogg','sound/ambience/noises/wolf(3).ogg','sound/ambience/noises/genspooky(1).ogg','sound/ambience/noises/genspooky(4).ogg','sound/ambience/noises/genspooky(2).ogg','sound/ambience/noises/genspooky(3).ogg','sound/ambience/noises/genspooky(5).ogg'); ambientrain = list('sound/ambience/rainout.ogg'); roughterrain = 1})
